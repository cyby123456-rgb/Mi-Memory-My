# Never commit a file containing real credentials. Load these variables only in
# the process environment that starts the service.

# Fact extraction, query planning, and multimodal analysis.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
# Optional OpenAI-compatible structured-response mode for the JSON contracts.
OPENAI_JSON_MODE=1

# Vector indexing and query embeddings.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_API_BASE=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=1024

# Independent judge, critic, and LLM reranker.
EVALUATOR_API_KEY=
EVALUATOR_API_BASE=
EVALUATOR_MODEL=
EVALUATOR_JSON_MODE=1

# Set to 1 only when the process is intentionally allowed to call remote models.
MIMEMORY_REMOTE_MODELS_ENABLED=1
# Deliberately leave this disabled. Set it to 1 only after an explicit approval
# for the specific live call has been obtained.
MIMEMORY_LIVE_PROVIDER_APPROVED=0
